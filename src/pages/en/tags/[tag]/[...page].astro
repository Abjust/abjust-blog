---
import type { GetStaticPaths } from "astro";
import TagPage from "@/pages/tags/[tag]/[...page].astro";
import { getTagPaths } from "@/utils/getStaticPaths";

export const getStaticPaths = (({ paginate }) =>
  getTagPaths(paginate, "en")) satisfies GetStaticPaths;
---

<TagPage {...Astro.props} />
